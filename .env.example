PET_CHAT_ENDPOINT=
PET_CHAT_MODEL=
PET_CHAT_ALLOWED_ORIGINS=
PET_CHAT_ALLOW_MISSING_ORIGIN=

# Local private blog publishing admin. Never deploy these values publicly.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_HOST=127.0.0.1
ADMIN_PORT=4001

# Optional: external static asset base for heavy files such as music and 3D models.
